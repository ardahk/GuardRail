# GuardRail local environment template
# Copy to .env and adjust as needed.

# Backend
API_HOST=127.0.0.1
API_PORT=8000
GUARDRAIL_DB_PATH=backend/guardrail.db
# Loopback targets are allowed for local fixtures. Private LAN targets are
# blocked by default; enable only for explicitly authorized internal systems.
GUARDRAIL_ALLOW_PRIVATE_TARGETS=false
VITE_API_BASE=http://127.0.0.1:8000
VITE_WS_BASE=ws://127.0.0.1:8000

# Shared attacker + judge preset. Change these two lines to switch both roles.
MODEL_PROVIDER=xai
MODEL_NAME=grok-4.3

# Provider credentials. Only the selected provider's key is required.
XAI_API_KEY=
OPENAI_API_KEY=

# Optional per-role overrides (otherwise MODEL_PROVIDER/MODEL_NAME are used).
# JUDGE_PROVIDER=openai
# SECURITY_JUDGE_MODEL=gpt-5-mini-2025-08-07
# Optional independent adjudicator for low-confidence or severity 7-10 findings.
# SECURITY_ADJUDICATOR_MODEL=grok-4.3
# ATTACKER_PROVIDER=openai
# ATTACKER_MODEL=gpt-5-mini-2025-08-07
# Optional: when 1 (default), fall back to keyword heuristic if the LLM judge errors out
# on API targets too. Set to 0 to keep the legacy "unjudged" behavior on API targets.
JUDGE_HEURISTIC_ON_API=1

# Demo target
DEMO_TARGET_URL=http://127.0.0.1:7070
# Set VICTIM_MODEL to use a real victim model (e.g. gpt-5.4-nano or gemini-2.5-flash-lite)
# If using OpenAI-compatible victim models, set OPENAI_API_KEY.
# If using Gemini victim models, set GEMINI_API_KEY.
# Leave VICTIM_MODEL empty to use keyword-matching BurritoBot for offline demos.
VICTIM_MODEL=

# Optional startup command overrides for scripts/start-local.sh
GUARDRAIL_API_START_CMD="python3 -m uvicorn backend.main:app --host 127.0.0.1 --port 8000"
GUARDRAIL_WEB_START_CMD="npm run dev -- --host 127.0.0.1 --port 3000"
GUARDRAIL_DEMO_START_CMD="npm --prefix demo-target run dev"

# Browser proxy (for local/owned website chatbot testing)
PLAYWRIGHT_PROXY_PORT=7071
PLAYWRIGHT_PROXY_URL=http://127.0.0.1:7071
PLAYWRIGHT_SELECTOR_MEMORY_PATH=/tmp/guardrail-selector-memory.json
# DOM excerpts are redacted and stored in run artifacts. Screenshots are opt-in
# because they may contain customer data on an authorized target.
PLAYWRIGHT_ARTIFACT_DIR=/tmp/guardrail-browser-artifacts
PLAYWRIGHT_CAPTURE_SCREENSHOTS=false
# Used only when an operator explicitly enables model-assisted browser fallback.
# Defaults to MODEL_PROVIDER / MODEL_NAME when omitted.
# BROWSER_VISION_PROVIDER=xai
# BROWSER_VISION_MODEL=grok-4.3
GUARDRAIL_PROXY_START_CMD="npm --prefix playwright-proxy run start"
BROWSER_ENGINE=cloakbrowser
CLOAKBROWSER_HEADLESS=true
CLOAKBROWSER_HUMANIZE=true
CLOAKBROWSER_AUTO_UPDATE=false
# Persistent profiles retain authenticated sessions per project + target origin.
# Keep browser lanes serial when this is enabled to avoid Chromium profile locks.
CLOAKBROWSER_PROFILE_DIR=../.guardrail/browser-profiles
BROWSER_MAX_PARALLEL_LANES=1
BROWSER_WARMUP_TIMEOUT_MS=120000
PLAYWRIGHT_ACTION_TIMEOUT_MS=12000
PLAYWRIGHT_APPENDED_MESSAGE_WAIT_MS=3000
PLAYWRIGHT_NEW_MESSAGE_TIMEOUT_MS=30000
PLAYWRIGHT_MAX_RESPONSE_WAIT_MS=45000

# Test-mode knobs
ENABLE_INTEGRATION_TESTS=false
GUARDRAIL_FIXTURE_PORT=7080
GUARDRAIL_FIXTURE_FRAME_PORT=7081
